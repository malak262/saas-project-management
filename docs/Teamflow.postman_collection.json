{
  "info": {
    "name": "Teamflow API",
    "description": "Run registration or sign-in first. See API.md for roles and OAuth setup. Destructive requests act only on the IDs you configure.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "you@example.com"
    },
    {
      "key": "password",
      "value": "choose-your-local-password"
    },
    {
      "key": "teammateEmail",
      "value": "teammate@example.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "workspaceId",
      "value": "1"
    },
    {
      "key": "projectId",
      "value": "1"
    },
    {
      "key": "taskId",
      "value": "1"
    },
    {
      "key": "version",
      "value": "1"
    },
    {
      "key": "invitationId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Your Name\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data=pm.response.json();",
              "pm.collectionVariables.set(\"token\",data.token);"
            ]
          }
        }
      ]
    },
